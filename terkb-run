#!/bin/sh
# Запуск terkb из каталога с исходниками: пакет лежит рядом, ставить его
# куда-либо не нужно. Этот файл прописывается в Exec= ярлыка, а ярлык
# запускается с произвольным рабочим каталогом — поэтому путь к пакету
# передаётся явно.
DIR="$(cd "$(dirname "$0")" && pwd)"
exec env PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" python3 -m terkb "$@"
